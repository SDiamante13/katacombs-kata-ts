# Symlinked skill directories are staged as links; prettier refuses one by name.
files=$(git diff --cached --name-only --diff-filter=ACMR | while read -r f; do
  [ -L "$f" ] || printf '%s\n' "$f"
done)
if [ -n "$files" ]; then
  echo "$files" | xargs npx prettier --ignore-unknown --write
  echo "$files" | xargs git add
fi

# Tier 2. SENSORS=agent means the loop already ran the cheap sensors.
if node scripts/git-tier.mjs; then
  npm run check
else
  # ...so make it prove the agent tier actually ran.
  node scripts/sensors-doctor.mjs --assert || exit 1
  echo "SENSORS=agent — cheap sensors already ran per edit; checking behavior only."
  npm run check:behavioral
fi
