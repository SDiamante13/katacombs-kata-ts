files=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -n "$files" ]; then
  echo "$files" | xargs npx prettier --ignore-unknown --write
  echo "$files" | xargs git add
fi

# Tier 2 of the trigger ladder. SENSORS=agent means the cheap sensors already
# fired inside the agent loop, so the commit gate only adds what they skipped.
if node scripts/git-tier.mjs; then
  npm run check
else
  echo "SENSORS=agent — cheap sensors already ran per edit; checking behavior only."
  npm run check:behavioral
fi
