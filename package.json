{
  "name": "katacombs-kata-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A text adventure built under three quality sensors.",
  "license": "MIT",
  "scripts": {
    "behavior:report": "node scripts/behavior-report.mjs",
    "behavior:sensor": "node scripts/behavior-sensor.mjs",
    "check": "npm run typecheck && npm run secret:sensor && npm test && npm run lint:sensor && npm run dup:sensor && npm run docs:sensor && npm run behavior:sensor",
    "check:behavioral": "npm run typecheck && npm test",
    "docs:sensor": "node scripts/docs-sensor.mjs",
    "dup:sensor": "node scripts/jscpd-sensor.mjs",
    "format": "prettier --ignore-unknown --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:sensor": "eslint . --format ./scripts/eslint-sensor-formatter.mjs",
    "prepare": "husky",
    "secret:sensor": "node scripts/gitleaks-sensor.mjs",
    "sensors:doctor": "node scripts/sensors-doctor.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^26.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jscpd": "^5.0.16",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.2.7"
  }
}
