[0.0, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[6G```gherkin\u001b[K\r\u001b[5C\u001b[1BScenario:\u001b[16GLooking\u001b[24Gwhere\u001b[30Gsomething\u001b[40Glies\r\u001b[5C\u001b[1B  Given th\u001b[18Gplayer\u001b[25Gis in a loc\u001b[37Gtion whose\u001b[48Gnorth\u001b[54Gexit\u001b[59Gis\u001b[62Gdescribed\r\u001b[7C\u001b[1BWhen\u001b[13Gthey\u001b[18Gtype\u001b[23G\"LOOK\u001b[29GN\"\r\u001b[5C\u001b[1B  Then\u001b[13Gwhat lies north is described\r\u001b[7C\u001b[1BAnd the player\u001b[23Ghas\u001b[27Gnot\u001b[31Gmoved\r\u001b[7C\u001b[1B\u001b[K\r\u001b[5C\u001b[1BScenario\u001b[16GLooking somewhere\u001b[34Guninteresting\r\u001b[5C\u001b[1B  Given the player\u001b[25Gis\u001b[28Gin\u001b[31Ga\u001b[33Glocation\u001b[42Gwith\u001b[47Gnothing\u001b[55Grecorded\u001b[64Gto\u001b[67Gthe\u001b[71Gwest\r\u001b[7C\u001b[1BWhen th\u001b[16Gy type \"LOOK\u001b[29GW\"\r\u001b[7C\u001b[1BThen\u001b[13Gthey\u001b[18Gare\u001b[22Gtold\u001b[27Gthere\u001b[33Gis\u001b[36Gnothing\u001b[44Ginteresting\u001b[56Gthat\u001b[61Gway\r\u001b[7C\u001b[1BAnd thi\u001b[16G reply differs from the\u001b[40Gone\u001b[44Gfor\u001b[48Ga\u001b[50Gdirection\u001b[60Gthey\u001b[65Gcannot\u001b[72Gwalk\r\u001b[5C\u001b[2BScenario: Looking with no target\r\u001b[7C\u001b[1BWhen the player\u001b[24Gtypes\u001b[30G\"LOOK\"\u001b[K\r\u001b[7C\u001b[1BThen\u001b[13Gthe\u001b[17Gtitle\u001b[23Gand\u001b[27Gdescription\u001b[39Gof\u001b[42Gthe\u001b[46Gcurrent\u001b[54Glocation\u001b[63Gare\u001b[67Gprinted\u001b[75Gagain\r\u001b[9C\u001b[1B\u001b[K\r\u001b[5C\u001b[1BScenario:"]
[0.0, "o", "\u001b[16GLooking\u001b[24Gat\u001b[27Gsomething\u001b[37Gthat\u001b[42Gis\u001b[45Gnot\u001b[49Ga\u001b[51Gthing\r\u001b[7C\u001b[1BWhen the player types \"LOOK BANANA\"\r\u001b[7C\u001b[1BThen\u001b[13Gthey\u001b[18Gare\u001b[22Gtold\u001b[27Gthe\u001b[31Ginput\u001b[37Gwas\u001b[41Gnot\u001b[45Gunderstood\r\u001b[9C\u001b[1B\u001b[K\r\u001b[5C\u001b[1BScenario: Looking does\u001b[29Gnot\u001b[33Gmove\u001b[38Gyou\r\u001b[7C\u001b[1BGiven\u001b[14Gthe\u001b[18Gplayer\u001b[25Gis\u001b[28Gin\u001b[31Gthe\u001b[35GEntrance\u001b[44GHall\r\u001b[5C\u001b[1B \u001b[8GWhen\u001b[13Gthey\u001b[18Gtype\u001b[23G\"LOOK\u001b[29GN\"\u001b[32Gand\u001b[36Gthen\u001b[41G\"LOOK\"\r\u001b[5C\u001b[1B  Then the En\u001b[20Grance Hall is still\u001b[40Gthe\u001b[44Glocation\u001b[53Gprinted\r\u001b[5C\u001b[1B```\u001b[K\r\u001b[7C\u001b[1B\u001b[K\r\u001b[5C\u001b[1B**Out\u001b[12Gof\u001b[15Gscope.**\u001b[24GInspecting\u001b[35Gitems\u001b[41Gor\u001b[44Gdoors.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[5C\u001b[1B**Play\u001b[14Gt.** From one location,\u001b[38Glook\u001b[43Gin\u001b[46Gall\u001b[50Gfour\u001b[55Gdirections\u001b[66Gand\u001b[70Gconfirm\u001b[78Gyou\u001b[82Gget\u001b[86Ga\u001b[88Gdescribed\r\u001b[5C\u001b[1Bdirection, an uninteresting one, and\u001b[43Gno moveme\u001b[53Gt in \u001b[59Gither\u001b[65Gcase.\u001b[K\r\u001b[7C\u001b[1B\u001b[K\r\u001b[5C\u001b[1B---\r\u001b[2B \u001b[3G   [← Slice 0](slice-0-walk-th\u001b[34G-map.md) · [All slices](README.md) · [Slice 2 →](slice-2-open-the-way-through.md)\r\u001b["]
