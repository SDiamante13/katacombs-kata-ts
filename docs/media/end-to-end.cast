[0.0, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[8GWhen\u001b[13Gthey\u001b[18Gtype\u001b[23G\"GO\u001b[27GE\"\r\u001b[1B       Then they arrive at the location\u001b[41Gbeyond\u001b[48Git\r\u001b[1B\u001b[K\r\u001b[1B     Scenario: It stays open\u001b[K\r\u001b[7C\u001b[1BGiven\u001b[14Gthe\u001b[18Gplayer\u001b[25Ghas\u001b[29Gwalked\u001b[36Gthrough\u001b[44Gthe\u001b[48Gopen\u001b[53Ggate\r\u001b[1C\u001b[1B \u001b[4G    When they walk back west and then east again\r\u001b[7C\u001b[1BThen\u001b[13Gthey\u001b[18Gpass\u001b[23Gthrough\u001b[31Gwithout\u001b[39Gopening\u001b[47Ganything\u001b[56Ga\u001b[58Gsecond\u001b[65Gtime\r\u001b[1B\u001b[K\r\u001b[5C\u001b[1BScenario:\u001b[16GOpening\u001b[24Gwhat\u001b[29Gis\u001b[32Galready\u001b[40Gopen\r\u001b[1B \u001b[3G    \u001b[8GGiven\u001b[14Gthe iron \u001b[24Ga\u001b[26Ge is open\u001b[K\r\u001b[7C\u001b[1BWhen\u001b[13Gthe\u001b[17Gplayer\u001b[24Gtypes\u001b[30G\"OPEN\u001b[36GGATE\"\r\u001b[1B \u001b[3G     Then they are told it is already open\u001b[46G\u001b[K\r\u001b[2B \u001b[3G   Scenario:\u001b[16GOpening\u001b[24Gsomething\u001b[34Gthat\u001b[39Gdoes\u001b[44Gnot\u001b[48Gopen\r\u001b[7C\u001b[1BGiven\u001b[14Gthe\u001b[18Gplayer\u001b[25Gis\u001b[28Gin\u001b[31Ga\u001b[33Glocation\u001b[42Gwith\u001b[47Gno\u001b[50Gopenable\u001b[59Gthing\r\u001b[7C\u001b[1BWhen\u001b[13Gthey\u001b[18Gtype\u001b[23G\"OPEN\u001b[29GWALL\"\r\u001b[7C\u001b[1BThen\u001b[13Gthey\u001b[18Gare\u001b[22Gtold\u001b[27Gthat\u001b[32Gcannot\u001b[39Gbe\u001b[42Gdone\u001b[47Ghere\r\u001b[5C\u001b[2BScenario:\u001b[16"]
